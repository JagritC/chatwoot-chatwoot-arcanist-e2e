{
  "appRuntime": {
    "kind": "web",
    "runner": "docker",
    "entry": {
      "type": "compose",
      "files": [
        "docker-compose.arcanist.yml",
        ".arcanist/docker-compose.override.yml"
      ],
      "service": "web"
    },
    "url": {
      "hostPort": 3000,
      "path": "/"
    },
    "portMapping": {
      "containerPort": 3000
    },
    "additionalPorts": [
      {
        "service": "vite",
        "hostPort": 3036,
        "containerPort": 3036
      }
    ],
    "composeEnv": {
      "ACTIVE_STORAGE_SERVICE": "local",
      "ENABLE_ACCOUNT_SIGNUP": "true",
      "FORCE_SSL": "false",
      "FRONTEND_URL": "http://127.0.0.1:3000",
      "INSTALLATION_ENV": "docker",
      "LOG_LEVEL": "info",
      "MAILER_SENDER_EMAIL": "Chatwoot <accounts@chatwoot.com>",
      "NODE_ENV": "development",
      "POSTGRES_DATABASE": "chatwoot",
      "POSTGRES_HOST": "postgres",
      "POSTGRES_PASSWORD": "postgres",
      "POSTGRES_PORT": "5432",
      "POSTGRES_USERNAME": "postgres",
      "RAILS_ENV": "development",
      "RAILS_LOG_TO_STDOUT": "true",
      "REDIS_PASSWORD": "redis",
      "REDIS_URL": "redis://:redis@redis:6379",
      "SECRET_KEY_BASE": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "SMTP_ADDRESS": "mailhog",
      "SMTP_PORT": "1025"
    },
    "ready": {
      "path": "/health",
      "timeoutSeconds": 90
    },
    "open": {
      "path": "/app/login"
    },
    "auth": {
      "command": ".arcanist/auth.sh",
      "validatePath": "/app"
    }
  },
  "verify": {
    "test": {
      "command": ".arcanist/verify/runtime-smoke.sh",
      "rules": [
        {
          "name": "arcanist-runtime-smoke",
          "paths": [
            ".arcanist/**",
            ".arcanist.json",
            "ARCANIST.md",
            "docker-compose.arcanist.yml"
          ],
          "command": ".arcanist/verify/runtime-smoke.sh"
        }
      ],
      "timeoutSeconds": 900
    }
  },
  "pr": {
    "templatePath": ".arcanist/pr-template.md"
  }
}
